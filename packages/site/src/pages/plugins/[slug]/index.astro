---
import { getReports } from '../../../utils/reports.ts';
import RiskBadge from '../../../components/RiskBadge.astro';
import FindingsTable from '../../../components/FindingsTable.astro';
import DiffView from '../../../components/DiffView.astro';
import ObfuscationAlert from '../../../components/ObfuscationAlert.astro';
import FileTree from '../../../components/FileTree.astro';

export async function getStaticPaths() {
  const reports = await getReports();
  return reports.map((r) => ({ params: { slug: r.slug }, props: { report: r } }));
}

const { report } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Report for {report.slug} @ {report.commitShort} — Omarchy Plugin Audit</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    body { font-family: system-ui, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #111; }
    a { color: #2563eb; }
    code { background: #f3f4f6; padding: 0.2rem 0.4rem; border-radius: 4px; font-size: 0.85em; }
  </style>
</head>
<body>
  <a href="/">← Back to overview</a>
  <h1>{report.slug} <RiskBadge level={report.riskLevel} /></h1>
  <p>
    Commit: <a href={report.commitUrl} target="_blank">{report.commit}</a> ({report.commitShort}) — Scanned: {new Date(report.scannedAt).toLocaleString()}
    {report.obfuscationFlag && <span style="color:red; font-weight:bold;"> — Possible obfuscation</span>}
  </p>
  {report.fromCommit ? (
    <p>Changed files since <a href={`${report.url}/compare/${report.fromCommit}...${report.commit}`} target="_blank">{report.fromCommitShort}...{report.commitShort}</a></p>
  ) : (
    <p>First scan — all files are new.</p>
  )}
  <p>Score: <strong>{report.score}</strong> — Risk: <strong>{report.riskLevel}</strong></p>

  <ObfuscationAlert flag={report.obfuscationFlag} findings={report.obfuscation} />

  <h2>Operations Summary</h2>
  <p class="text-sm text-gray-600">Inventory of operations detected (file, network, process, imports).</p>
  <FindingsTable findings={report.findings} title="All Findings" />

  <h2>Network Calls</h2>
  <FindingsTable findings={report.inventory.networkCalls} title="Network Calls" />

  <h2>Files Opened</h2>
  <FindingsTable findings={report.inventory.fileOps} title="Files Opened" />

  <h2>Process Execution</h2>
  <FindingsTable findings={report.inventory.processes} title="Process Execution" />

  <h2>Changed Files</h2>
  <DiffView files={report.diff.filesChanged} commits={report.diff.commits} />

  <h2>File Tree</h2>
  <FileTree files={report.fileTree} />

  <hr class="my-8" />
  <p class="text-xs text-gray-500">Generated by omarchy-audit at {report.scannedAt}. Commit hash is linked to GitHub for verification.</p>
</body>
</html>
