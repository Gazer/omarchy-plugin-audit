---
const { llmAnalysis } = Astro.props;
const riskColors: Record<string, string> = {
  safe: 'bg-slate-100 text-slate-700 border-slate-200',
  low: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  medium: 'bg-amber-50 text-amber-800 border-amber-200',
  high: 'bg-orange-50 text-orange-800 border-orange-200',
  critical: 'bg-red-50 text-red-800 border-red-200',
};
const riskDot: Record<string, string> = {
  safe: 'bg-slate-400',
  low: 'bg-emerald-500',
  medium: 'bg-amber-500',
  high: 'bg-orange-500',
  critical: 'bg-red-500',
};
---

{llmAnalysis ? (
  <div class="space-y-6 my-8">
    <!-- What it does -->
    {llmAnalysis.whatItDoes && (
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">What this plugin does</h3>
        <p class="text-[15px] leading-relaxed text-slate-800">{llmAnalysis.whatItDoes}</p>
      </div>
    )}

    <!-- AI summary + risk -->
    <div class={`rounded-xl border p-6 ${riskColors[llmAnalysis.overallRisk] || riskColors.medium}`}>
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider opacity-70">AI Review</h3>
        <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase border ${riskColors[llmAnalysis.overallRisk]}`}>
          <span class={`w-2 h-2 rounded-full ${riskDot[llmAnalysis.overallRisk]}`}></span>
          {llmAnalysis.overallRisk}
        </span>
      </div>
      <p class="text-sm leading-relaxed">{llmAnalysis.summary}</p>
      <p class="text-xs opacity-60 mt-3">Model {llmAnalysis.model} • {new Date(llmAnalysis.generatedAt).toLocaleString()}</p>
    </div>

    <!-- Sequence diagram -->
    {llmAnalysis.sequenceDiagram && llmAnalysis.sequenceDiagram.trim() !== "" && (
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">How it works — sequence</h3>
        <div class="bg-slate-50 rounded-lg p-4 overflow-x-auto">
          <pre class="mermaid text-sm">{llmAnalysis.sequenceDiagram}</pre>
        </div>
        <p class="text-xs text-slate-400 mt-2">Generated by AI from static findings + file context</p>
      </div>
    )}

    <!-- Refined findings as cards -->
    {llmAnalysis.findings && llmAnalysis.findings.length > 0 && (
      <div>
        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">Findings — AI refined ({llmAnalysis.findings.length})</h3>
        <div class="grid gap-3">
          {llmAnalysis.findings.map((f: any) => (
            <div class="bg-white rounded-lg border border-slate-200 p-4 flex flex-col gap-2">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs bg-slate-100 px-2 py-1 rounded border">{f.file}:{f.line}</span>
                  <span class="font-mono text-xs text-slate-600">{f.pattern}</span>
                  <span class="text-xs text-slate-400">{f.originalSeverity} →</span>
                  <span class={`text-xs font-bold px-2 py-0.5 rounded-full border ${riskColors[f.refinedSeverity] || 'bg-slate-50'}`}>{f.refinedSeverity}</span>
                </div>
                <span class={`text-xs px-2 py-1 rounded-full font-medium ${f.isBenign ? 'bg-emerald-50 text-emerald-700' : f.isMalicious ? 'bg-red-50 text-red-700' : 'bg-amber-50 text-amber-700'}`}>
                  {f.isMalicious ? 'malicious' : f.isBenign ? 'benign' : 'needs review'}
                </span>
              </div>
              <p class="text-sm text-slate-700">{f.reasoning}</p>
              {(f.relatedCode || f.executableContext) && (
                <div class="bg-slate-50 rounded p-2.5 text-xs font-mono text-slate-600 border">
                  {f.relatedCode && <div>↳ {f.relatedCode}</div>}
                  {f.executableContext && <div class="text-slate-500 mt-1">ℹ {f.executableContext}</div>}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
) : (
  <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 my-6">
    <h3 class="text-sm font-semibold text-amber-800 mb-1">No AI review yet</h3>
    <p class="text-sm text-amber-900/70">This report is static only (regex). Re-run audit with <code class="bg-white px-1.5 py-0.5 rounded border font-mono text-xs">--with-llm</code> to generate contextual analysis, what-it-does summary, and a sequence diagram with <code class="bg-white px-1 py-0.5 rounded border font-mono text-xs">opencode-go/muse-spark-1.2-contributor</code>.</p>
  </div>
)}

<script is:inline type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
  mermaid.initialize({ startOnLoad: true, theme: 'base', themeVariables: { primaryColor: '#f8fafc' } });
</script>
