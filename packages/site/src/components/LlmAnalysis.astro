---
const { llmAnalysis } = Astro.props;
const riskColors: Record<string, string> = {
  safe: 'bg-gray-200 text-gray-800',
  low: 'bg-green-200 text-green-800',
  medium: 'bg-yellow-200 text-yellow-800',
  high: 'bg-orange-200 text-orange-800',
  critical: 'bg-red-200 text-red-800',
};
---
{llmAnalysis ? (
  <div class="border rounded-lg p-4 my-6 bg-blue-50 border-blue-200">
    <h3 class="text-lg font-semibold mb-2">AI Review <span class="text-xs font-normal text-gray-500">({llmAnalysis.model})</span></h3>
    <div class="flex items-center gap-2 mb-3">
      <span class={`px-2 py-1 rounded text-xs font-semibold uppercase ${riskColors[llmAnalysis.overallRisk] || riskColors.medium}`}>{llmAnalysis.overallRisk}</span>
      <span class="text-xs text-gray-500">generated {new Date(llmAnalysis.generatedAt).toLocaleString()}</span>
    </div>
    <p class="text-sm mb-4 bg-white p-3 rounded border">{llmAnalysis.summary}</p>
    {llmAnalysis.findings && llmAnalysis.findings.length > 0 && (
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm border bg-white">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-3 py-2 text-left border">File</th>
              <th class="px-3 py-2 text-left border">Pattern</th>
              <th class="px-3 py-2 text-left border">Original</th>
              <th class="px-3 py-2 text-left border">Refined</th>
              <th class="px-3 py-2 text-left border">Benign?</th>
              <th class="px-3 py-2 text-left border">Reasoning</th>
              <th class="px-3 py-2 text-left border">Related Code</th>
            </tr>
          </thead>
          <tbody>
            {llmAnalysis.findings.map((f: any) => (
              <tr class="border-t">
                <td class="px-3 py-1 border font-mono text-xs">{f.file}:{f.line}</td>
                <td class="px-3 py-1 border font-mono text-xs">{f.pattern}</td>
                <td class="px-3 py-1 border text-xs">{f.originalSeverity}</td>
                <td class={`px-3 py-1 border text-xs font-semibold ${f.refinedSeverity === 'critical' ? 'text-red-600' : f.refinedSeverity === 'high' ? 'text-orange-600' : ''}`}>{f.refinedSeverity}</td>
                <td class="px-3 py-1 border text-xs">{f.isBenign ? 'yes' : 'no'}{f.isMalicious ? ' (malicious)' : ''}</td>
                <td class="px-3 py-1 border text-xs max-w-[350px]">{f.reasoning}</td>
                <td class="px-3 py-1 border font-mono text-xs max-w-[250px] truncate">{f.relatedCode || f.executableContext || ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
) : (
  <div class="border rounded p-3 my-4 bg-gray-50 text-sm text-gray-600">
    <p>AI review not run. Re-run audit with <code>--with-llm</code> to generate contextual analysis with <code>opencode-go/muse-spark-1.2-contributor</code>.</p>
  </div>
)}
